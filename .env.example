# ==========================================
# FizzDrop Database Configuration for Aiven
# ==========================================

# Option 1: Aiven Service URI (Recommended - copy-paste directly from Aiven Console overview)
# DB_URL=mysql://avnadmin:YOUR_AIVEN_PASSWORD@mysql-xxxx-xxxx.aivencloud.com:PORT/defaultdb?ssl-mode=REQUIRED

# Option 2: Standard Cloud JDBC URL
# DB_URL=jdbc:mysql://mysql-xxxx-xxxx.aivencloud.com:PORT/defaultdb?sslMode=REQUIRED&useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USER=avnadmin
# DB_PASSWORD=YOUR_AIVEN_PASSWORD
